<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>C_sharp_Project</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The class library and the tests live in sub-folders with their own projects;
         keep this project's default globs from picking up their sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClinicManagement.Core\**;ClinicManagement.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bunifu.UI.WinForms" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ClinicManagement.Core\ClinicManagement.Core.csproj" />
  </ItemGroup>

</Project>
